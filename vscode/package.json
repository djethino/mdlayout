{
  "name": "mdlayout",
  "displayName": "mdlayout — Markdown layout",
  "description": "Reads mdlayout and MarkdownRoxor documents in VS Code's Markdown preview: page layout, callouts, footnotes, task lists, table of contents, numbered figures and equations, document themes — and previews standalone Mermaid files.",
  "version": "0.1.2",
  "publisher": "asymptomatik",
  "author": "ASymptOmatik",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "markdown",
    "layout",
    "preview",
    "mdlayout"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/djethino/mdlayout"
  },
  "bugs": {
    "url": "https://github.com/djethino/mdlayout/issues"
  },
  "homepage": "https://github.com/djethino/mdlayout#readme",
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./media/mdlayout.css",
      "./styles/markdownroxor.css"
    ],
    "grammars": [
      {
        "scopeName": "markdown.mdlayout.injection",
        "path": "./syntaxes/mdlayout.injection.json",
        "injectTo": [
          "text.html.markdown"
        ]
      },
      {
        "language": "mermaid",
        "scopeName": "source.mermaid",
        "path": "./syntaxes/mermaid.tmLanguage.json"
      }
    ],
    "languages": [
      {
        "id": "mermaid",
        "aliases": [
          "Mermaid"
        ],
        "extensions": [
          ".mmd",
          ".mermaid"
        ],
        "configuration": "./syntaxes/mermaid.language.json"
      }
    ],
    "commands": [
      {
        "command": "mdlayout.previewMermaid",
        "title": "Preview Mermaid Diagram",
        "category": "mdlayout",
        "icon": "$(open-preview)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mdlayout.previewMermaid",
          "when": "resourceExtname =~ /\\.(mmd|mermaid)$/i",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "mdlayout.previewMermaid",
          "when": "resourceExtname =~ /\\.(mmd|mermaid)$/i",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "mdlayout.previewMermaid",
          "when": "resourceExtname =~ /\\.(mmd|mermaid)$/i"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "vscode:prepublish": "node scripts/build.mjs"
  }
}
