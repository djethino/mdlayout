{
  "name": "mdlayout",
  "displayName": "mdlayout — Markdown layout",
  "description": "Spatial layout for Markdown in the preview: blocks side by side, images and videos with layout hints, styled text — the mdlayout syntax.",
  "version": "0.1.1",
  "publisher": "asymptomatik",
  "author": "ASymptOmatik",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "markdown",
    "layout",
    "preview",
    "mdlayout"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/djethino/mdlayout"
  },
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./media/mdlayout.css"
    ],
    "grammars": [
      {
        "scopeName": "markdown.mdlayout.injection",
        "path": "./syntaxes/mdlayout.injection.json",
        "injectTo": [
          "text.html.markdown"
        ]
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "vscode:prepublish": "node scripts/build.mjs"
  },
  "bugs": {
    "url": "https://github.com/djethino/mdlayout/issues"
  },
  "homepage": "https://github.com/djethino/mdlayout#readme"
}
